# ==============================================================================
# StructuralAI - Environment Configuration Template
# Copy this file to .env (or configure in Vercel / hosting provider environment settings).
# NEVER commit your actual .env file or production secret keys to version control!
# ==============================================================================

# Server-Side Computer Vision Workflow (Keep secret on server / Vercel Environment Variables)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/kumar-ritovash/workflows/building-infrastructure-defects-logic

# Server-Side AI Forensic Reasoning & Reporting (Keep secret on server / Vercel Environment Variables)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Supabase Public Credentials (Required for auth and database operations)
# Note: Publishable anon keys are exposed to the client; secure your data using Row Level Security (RLS).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
